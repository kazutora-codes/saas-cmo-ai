# Optional free-tier keys. Leave empty to use Ollama only.
GROQ_API_KEY=
GEMINI_API_KEY=

# X (Twitter) — free developer app. Without these, posts are exported for manual copy-paste.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# LinkedIn — optional; personal posting API is restricted. Default is manual export.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
